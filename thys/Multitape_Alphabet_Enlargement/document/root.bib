@Article{         Rosenberg1967:realtime,
  author        = {Rosenberg, Arnold L.},
  title         = {Real-Time Definable Languages},
  year          = {1967},
  issue_date    = {Oct. 1967},
  publisher     = {Association for Computing Machinery},
  address       = {New York, NY, USA},
  volume        = {14},
  number        = {4},
  issn          = {0004-5411},
  doi           = {10.1145/321420.321423},
  abstract      = {The closure properties of the class of languages defined
                  by real-time, online, multi-tape Turing machines are
                  proved. The results obtained are, for the most part,
                  negative and, as one would expect, asymmetric. It is shown
                  that the results remain valid for a broad class of
                  real-time devices. Finally, the position of the class of
                  real-time definable languages in the ``classical''
                  linguistic hierarchy is established.},
  journal       = {J. ACM},
  month         = oct,
  pages         = {645--662},
  numpages      = {18}
}

